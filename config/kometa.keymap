#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define SYM  1
#define NAV  2
#define FN   3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        fn_when_nav_and_sym {
            if-layers = <NAV SYM>;
            then-layer = <FN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp GRAVE  &kp Q  &kp W  &kp E  &kp R  &kp T         &kp Y  &kp U  &kp I      &kp O    &kp P     &kp SQT
                &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G         &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp LALT
                &kp DEL    &kp Z  &kp X  &kp C  &kp V  &kp B         &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp LGUI
                                                    &lt NAV TAB  &kp SPACE  &kp RET  &lt SYM ESC  &kp BSPC  &kp LSHFT
            >;
        };

        /* Numbers on the left; paired brackets on the right.
         * Ctrl/Alt/GUI/Shift keys are transparent so modified symbols work.
         * &kp BSLH provides the backslash displaced from Base.
         */
        sym_layer {
            display-name = "Symbols";
            bindings = <
                &kp PIPE        &kp N7  &kp N8  &kp N9  &kp ASTERISK  &kp EQUAL    &kp EXCLAMATION  &kp AT_SIGN      &kp HASH                &kp DOLLAR              &kp PERCENT        &kp CARET
                &trans          &kp N4  &kp N5  &kp N6  &kp AMPERSAND &kp MINUS    &kp COLON        &kp LEFT_BRACKET &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &trans
                &kp UNDERSCORE  &kp N1  &kp N2  &kp N3  &kp N0        &kp PLUS     &kp BSLH         &kp LEFT_BRACE   &kp LESS_THAN           &kp GREATER_THAN        &kp RIGHT_BRACE    &trans
                                                       &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* Hold left-outside thumb for Nav; right hand gets H/J/K/L arrows.
         * Real Ctrl + real Shift + Nav + arrows can be held simultaneously.
         * Bottom right language switch uses Win/Super+Space, as before.
         */
        nav_layer {
            display-name = "Navigation";
            bindings = <
                &trans  &caps_word &trans  &trans  &trans  &trans     &kp HOME        &kp PG_DN       &kp PG_UP       &kp END          &kp C_VOLUME_DOWN   &kp C_VOLUME_UP
                &trans  &trans     &trans  &trans  &trans  &trans     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &kp DEL             &trans
                &trans  &trans     &trans  &trans  &trans  &trans     &trans          &trans          &kp C_BRIGHTNESS_DEC &kp C_BRI_UP   &kp RG(SPACE)      &trans
                                              &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* Hold BOTH thumb layer keys to access FN/OS/Bluetooth controls.
         * Reset/bootloader/clear pairing are not reachable from base.
         */
        fn_layer {
            display-name = "Function/System";
            bindings = <
                &none   &kp F1  &kp F2   &kp F3   &kp F4   &none       &none          &none          &none          &none             &bootloader       &sys_reset
                &trans  &kp F5  &kp F6   &kp F7   &kp F8   &none       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3      &bt BT_CLR        &trans
                &kp LC(LA(DEL))  &kp F9  &kp F10  &kp F11  &kp F12  &none       &ext_power EP_TOG  &out OUT_TOG  &soft_off   &bt BT_CLR_ALL    &none             &trans
                                                  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
